# Firebase Client Configuration for Sky Quest Holidays
# Replace with your actual Firebase Project credentials from Firebase Console
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=sky-quest-holidays.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=sky-quest-holidays
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=sky-quest-holidays.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# Optional: Default Admin fallback login
NEXT_PUBLIC_ADMIN_DEFAULT_USER=admin
NEXT_PUBLIC_ADMIN_DEFAULT_PASS=skyquest2026
